[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/level_complete.gd" id="1_complete"]

[node name="LevelComplete" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_complete")

[node name="Fundo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.07, 0.1, 0.08, 1)

[node name="Central" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Conteudo" type="VBoxContainer" parent="Central"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Titulo" type="Label" parent="Central/Conteudo"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "JOGO CONCLUÍDO!"
horizontal_alignment = 1

[node name="Menu" type="Button" parent="Central/Conteudo"]
custom_minimum_size = Vector2(300, 52)
layout_mode = 2
text = "VOLTAR AO MENU"

[connection signal="pressed" from="Central/Conteudo/Menu" to="." method="_on_menu_pressed"]
